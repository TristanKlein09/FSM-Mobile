<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/button_background.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bottom layer -->
    <item>
        <shape>
            <corners android:radius="0dp"/>
            <gradient
                android:startColor="#297ED0"
                android:centerColor="#25B3FF"
                android:endColor="#DDEEFF"
                android:angle="45" />
        </shape>
    </item>

    <!-- Top layer -->
    <item android:top="275dp">
        <shape>
            <solid android:color="#FFFFFF"/>
            <corners android:topLeftRadius="38dp"
                android:topRightRadius="38dp"/>
        </shape>
    </item>

</layer-list>